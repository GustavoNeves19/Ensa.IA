# Copie para .env e preencha. O arquivo .env está no .gitignore e NUNCA
# deve ser commitado.
#
#   cp .env.example .env

# Chave da API do modelo de linguagem usado na camada narrativa.
GOOGLE_API_KEY=

# Modelo a usar. Registrar no relatório de validação qual foi usado —
# a taxa de fidelidade do §4.3(e) é específica de modelo + versão do prompt.
EnsaIA_MODELO_LLM=gemini-2.5-flash

# Temperatura. Manter 0.0 durante a coleta de dados de validação: com
# temperatura maior, duas execuções sobre o mesmo resultado dão relatórios
# diferentes e a métrica de fidelidade vira ruído.
EnsaIA_TEMPERATURA=0.0
