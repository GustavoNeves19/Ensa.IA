# Copie para .env e preencha. O arquivo .env está no .gitignore e NUNCA
# deve ser commitado.
#
#   cp .env.example .env

# IA oferecida pelo servidor (opcional). Sem ela, o usuário escolhe na tela:
# texto sem IA, copiar o pedido para a IA dele ou usar a própria chave.
# Qualquer API compatível com OpenAI serve (OpenAI, Gemini, Groq, OpenRouter).
ENSAIA_IA_CHAVE=
# Padrão: https://api.openai.com/v1
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
ENSAIA_IA_URL=
# Registrar no relatório de validação qual modelo foi usado: a taxa de
# fidelidade do §4.3(e) é específica de modelo + versão do prompt.
ENSAIA_IA_MODELO=gpt-4o-mini

# Endereço do Ollama, quando o servidor tem um (IA local, modo M2).
# Ex.: http://ollama:11434/v1 no docker compose com o serviço ollama.
ENSAIA_OLLAMA_URL=
